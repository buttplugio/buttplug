{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Buttplug User Device Configuration (v5)",
  "description": "User device configuration (`buttplug-user-device-config-v5.json`). It holds per-device customizations, extra communication specifiers and simulated devices. intiface-engine rewrites it whenever a device connects (when given a user config path), and frontends such as Intiface Central rewrite it after settings changes. Keys not declared in this schema are ignored by the loader, which logs a warning for each so they can be found before a future version rejects them. The exceptions are `output` and `input` maps, where an unknown type is an error. Objects that set `additionalProperties: true` accept unknown keys on purpose, and those keys are not warned about.",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "Not used by the loader. Optional URI of the JSON Schema for this file, so editors can validate and autocomplete it. The loader does not write it back when it saves the user config.",
      "type": "string"
    },
    "version": {
      "$ref": "#/$defs/version"
    },
    "user_configs": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "protocols": {
              "anyOf": [
                {
                  "description": "Map of protocol name to user additions. Only `communication` is written back on save.",
                  "type": "object",
                  "additionalProperties": {
                    "$ref": "#/$defs/userProtocol"
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "devices": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/userDevice"
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "simulated_devices": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/simulatedDevice"
                  }
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "version"
  ],
  "$defs": {
    "version": {
      "description": "File format version. `major` must equal the library's built-in major version (5) or the file is rejected. `minor` is never compared on load.",
      "type": "object",
      "properties": {
        "major": {
          "const": 5
        },
        "minor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "description": "Revision of the file. When the user config is saved, the loader writes the built-in base config's minor version here."
        }
      },
      "required": [
        "major",
        "minor"
      ]
    },
    "uuid": {
      "description": "UUID. The loader accepts simple, hyphenated, braced and URN forms, with hex digits in either case. Saved files use lowercase hyphenated form.",
      "type": "string",
      "pattern": "^(?:[0-9a-fA-F]{32}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}|\\{[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}\\}|urn:uuid:[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$"
    },
    "u8": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "u16": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    },
    "u32": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "i32RangeInclusive": {
      "description": "Inclusive range `[start, end]`. A negative `start` (for example `[-20, 20]` for rotate) marks a bidirectional output, with steps symmetric around 0.",
      "type": "array",
      "prefixItems": [
        {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        }
      ],
      "minItems": 2,
      "maxItems": 2,
      "items": false
    },
    "communicationSpecifiers": {
      "description": "How hardware is matched to this protocol. On load, user specifiers are appended to the base specifiers for the same protocol; they do not replace them.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/communicationSpecifier"
      }
    },
    "communicationSpecifier": {
      "description": "An object with exactly one key naming the connector type. Unknown connector types are skipped with a warning, for forward compatibility. A known connector with an invalid body is an error.",
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": true,
      "properties": {
        "btle": {
          "$ref": "#/$defs/btleSpecifier"
        },
        "hid": {
          "$ref": "#/$defs/vidPidSpecifier"
        },
        "usb": {
          "$ref": "#/$defs/vidPidSpecifier"
        },
        "serial": {
          "$ref": "#/$defs/serialSpecifier"
        },
        "sdl-gamepad": {
          "$ref": "#/$defs/existsSpecifier"
        },
        "lovense_connect_service": {
          "$ref": "#/$defs/existsSpecifier"
        },
        "websocket": {
          "$ref": "#/$defs/websocketSpecifier"
        },
        "simulated": {
          "$ref": "#/$defs/simulatedSpecifier"
        }
      }
    },
    "btleSpecifier": {
      "description": "Bluetooth LE matching. A device matches when any of these hold, checked in order: an advertised name is in `names`; a `names` entry ending in `*` is a prefix of the advertised name; `manufacturer_data` matches; or `advertised_services` intersect.",
      "type": "object",
      "properties": {
        "names": {
          "description": "Advertised names. A trailing `*` makes the entry a prefix wildcard.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "manufacturer_data": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "company": {
                "$ref": "#/$defs/u16"
              },
              "expected_length": {
                "$ref": "#/$defs/u32",
                "description": "Not used: the loader ignores this key. Listed in older schemas; matching uses `data` only."
              },
              "data": {
                "anyOf": [
                  {
                    "description": "Expected bytes. If omitted, only `company` is compared. If the lengths differ, the shorter sequence must appear contiguously in the longer one.",
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/u8"
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "company"
            ]
          }
        },
        "advertised_services": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/uuid"
          }
        },
        "services": {
          "description": "Map of service UUID to endpoint map. The device needs at least one of these services to be used with this protocol.",
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/uuid"
          },
          "additionalProperties": {
            "description": "Map of endpoint name to characteristic UUID.",
            "type": "object",
            "propertyNames": {
              "enum": [
                "command",
                "firmware",
                "rx",
                "rxaccel",
                "rxblebattery",
                "rxblemodel",
                "rxpressure",
                "rxtouch",
                "tx",
                "txmode",
                "txshock",
                "txvibrate",
                "txvendorcontrol",
                "whitelist",
                "generic0",
                "generic1",
                "generic2",
                "generic3",
                "generic4",
                "generic5",
                "generic6",
                "generic7",
                "generic8",
                "generic9",
                "generic10",
                "generic11",
                "generic12",
                "generic13",
                "generic14",
                "generic15",
                "generic16",
                "generic17",
                "generic18",
                "generic19",
                "generic20",
                "generic21",
                "generic22",
                "generic23",
                "generic24",
                "generic25",
                "generic26",
                "generic27",
                "generic28",
                "generic29",
                "generic30",
                "generic31"
              ]
            },
            "additionalProperties": {
              "$ref": "#/$defs/uuid"
            }
          }
        }
      },
      "required": [
        "names",
        "services"
      ]
    },
    "vidPidSpecifier": {
      "description": "USB/HID matching. The device matches if any pair matches.",
      "type": "object",
      "properties": {
        "pairs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "vendor_id": {
                "$ref": "#/$defs/u16"
              },
              "product_id": {
                "$ref": "#/$defs/u16"
              }
            },
            "required": [
              "vendor_id",
              "product_id"
            ]
          }
        }
      },
      "required": [
        "pairs"
      ]
    },
    "serialSpecifier": {
      "description": "Serial port device. Matching uses `port` only. All five fields are required to parse, but the serial manager only uses `port` and `baud_rate`. It always opens the port as 8/N/1.",
      "type": "object",
      "properties": {
        "port": {
          "type": "string",
          "description": "OS port name, e.g. `COM3` or `/dev/ttyUSB0`."
        },
        "baud_rate": {
          "$ref": "#/$defs/u32"
        },
        "data_bits": {
          "$ref": "#/$defs/u8",
          "description": "Parsed but currently unused."
        },
        "stop_bits": {
          "$ref": "#/$defs/u8",
          "description": "Parsed but currently unused."
        },
        "parity": {
          "description": "A single character, conventionally `N`. Parsed but currently unused.",
          "type": "string",
          "minLength": 1,
          "maxLength": 1
        }
      },
      "required": [
        "port",
        "baud_rate",
        "data_bits",
        "stop_bits",
        "parity"
      ]
    },
    "websocketSpecifier": {
      "description": "Device websocket server connection. Matches on the exact `name` sent in the device's handshake.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ]
    },
    "simulatedSpecifier": {
      "description": "Simulated devices. In the base config, the `names` listed under the `simulated` protocol are the valid simulated-device archetypes.",
      "type": "object",
      "properties": {
        "names": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "names"
      ]
    },
    "existsSpecifier": {
      "description": "Connector with no matching attributes; the connector's manager handles discovery. `exists` is required to parse, but its value is ignored.",
      "type": "object",
      "properties": {
        "exists": {
          "type": "boolean"
        }
      },
      "required": [
        "exists"
      ]
    },
    "protocolDefaults": {
      "description": "Protocol-level definition. It is used for any device the protocol matches that has no matching `configurations` entry. Its `protocol_variant`, `message_gap_ms` and `features` also fill in any of those fields a configuration omits.",
      "type": "object",
      "properties": {
        "identifier": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "Not used: the loader ignores this key. Defaults apply to every identifier the protocol has no configuration for."
        },
        "name": {
          "type": "string",
          "description": "Canonical device name."
        },
        "id": {
          "$ref": "#/$defs/uuid",
          "description": "Definition ID. A user config's `devices[].config.base_id` refers to this. It must be unique across the file."
        },
        "protocol_variant": {
          "anyOf": [
            {
              "type": "string",
              "description": "Protocol sub-mode. Currently only read by the `svakom`, `vorze-sa` and `sdl-gamepad` protocol implementations."
            },
            {
              "type": "null"
            }
          ]
        },
        "message_gap_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295,
              "description": "Minimum milliseconds between writes to the device."
            },
            {
              "type": "null"
            }
          ]
        },
        "features": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/feature"
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "id"
      ]
    },
    "configuration": {
      "description": "User-defined device model. Unlike the base file, protocol `defaults` are NOT merged in, so this must be complete. Loaded on startup, but not written back on save: the first save removes it.",
      "type": "object",
      "properties": {
        "identifier": {
          "anyOf": [
            {
              "description": "Protocol-reported identifiers that select this definition. One lookup entry is registered per string. The loader accepts a configuration without identifiers, but it can never be selected.",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string",
          "description": "Canonical device name."
        },
        "id": {
          "$ref": "#/$defs/uuid",
          "description": "Definition ID. A user config's `devices[].config.base_id` refers to this. It must be unique across the file."
        },
        "protocol_variant": {
          "anyOf": [
            {
              "type": "string",
              "description": "Protocol sub-mode. Currently only read by the `svakom`, `vorze-sa` and `sdl-gamepad` protocol implementations."
            },
            {
              "type": "null"
            }
          ]
        },
        "message_gap_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295,
              "description": "Minimum milliseconds between writes to the device."
            },
            {
              "type": "null"
            }
          ]
        },
        "features": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/feature"
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "id"
      ]
    },
    "feature": {
      "type": "object",
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "description": "Feature index exposed to clients."
        },
        "description": {
          "type": "string",
          "default": ""
        },
        "id": {
          "$ref": "#/$defs/uuid",
          "description": "Feature ID. A user config's `features[].base_id` refers to this."
        },
        "output": {
          "description": "At most one entry per output type. An unknown output type is a load error.",
          "type": "object",
          "properties": {
            "vibrate": {
              "$ref": "#/$defs/valueOutput"
            },
            "rotate": {
              "$ref": "#/$defs/valueOutput"
            },
            "oscillate": {
              "$ref": "#/$defs/valueOutput"
            },
            "constrict": {
              "$ref": "#/$defs/valueOutput"
            },
            "temperature": {
              "$ref": "#/$defs/valueOutput"
            },
            "led": {
              "$ref": "#/$defs/valueOutput"
            },
            "spray": {
              "$ref": "#/$defs/valueOutput"
            },
            "position": {
              "$ref": "#/$defs/positionOutput"
            },
            "hw_position_with_duration": {
              "$ref": "#/$defs/hwPositionWithDurationOutput"
            }
          },
          "additionalProperties": false
        },
        "input": {
          "description": "At most one entry per input type. An unknown input type is a load error.",
          "type": "object",
          "properties": {
            "battery": {
              "$ref": "#/$defs/input"
            },
            "rssi": {
              "$ref": "#/$defs/input"
            },
            "button": {
              "$ref": "#/$defs/input"
            },
            "pressure": {
              "$ref": "#/$defs/input"
            },
            "depth": {
              "$ref": "#/$defs/input"
            },
            "position": {
              "$ref": "#/$defs/input"
            }
          },
          "additionalProperties": false
        },
        "feature_settings": {
          "type": "object",
          "properties": {
            "alt_protocol_index": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4294967295,
                  "description": "Alternate index for the protocol implementation. Loaded, but currently no protocol implementation reads it."
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      },
      "required": [
        "index",
        "id"
      ]
    },
    "valueOutput": {
      "type": "object",
      "properties": {
        "value": {
          "$ref": "#/$defs/i32RangeInclusive",
          "description": "Hardware step range. The step count is `end` (or `-end..=end` when `start` is negative)."
        },
        "disabled": {
          "type": "boolean",
          "default": false
        },
        "description": {
          "type": "string",
          "description": "Not used: the loader ignores this key. It appears on `oscillate` in `device-config/protocols/ossm.yml`. Feature text belongs in the feature's `description`."
        }
      },
      "required": [
        "value"
      ]
    },
    "positionOutput": {
      "type": "object",
      "properties": {
        "value": {
          "$ref": "#/$defs/i32RangeInclusive"
        },
        "disabled": {
          "type": "boolean",
          "default": false
        },
        "reverse_position": {
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "value"
      ]
    },
    "hwPositionWithDurationOutput": {
      "type": "object",
      "properties": {
        "value": {
          "$ref": "#/$defs/i32RangeInclusive",
          "description": "Position range."
        },
        "duration": {
          "$ref": "#/$defs/i32RangeInclusive",
          "description": "Duration range (ms)."
        },
        "disabled": {
          "type": "boolean",
          "default": false
        },
        "reverse_position": {
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "value",
        "duration"
      ]
    },
    "input": {
      "type": "object",
      "properties": {
        "value": {
          "description": "One range per value the sensor reports.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/i32RangeInclusive"
          }
        },
        "command": {
          "description": "Supported input commands. Lowercase aliases are accepted on load; saved files use the capitalised form.",
          "type": "array",
          "items": {
            "enum": [
              "Read",
              "Subscribe",
              "Unsubscribe",
              "read",
              "subscribe",
              "unsubscribe"
            ]
          }
        }
      },
      "required": [
        "value",
        "command"
      ]
    },
    "userProtocol": {
      "type": "object",
      "properties": {
        "communication": {
          "anyOf": [
            {
              "$ref": "#/$defs/communicationSpecifiers"
            },
            {
              "type": "null"
            }
          ]
        },
        "defaults": {
          "anyOf": [
            {
              "$ref": "#/$defs/protocolDefaults"
            },
            {
              "type": "null"
            }
          ],
          "description": "Not used: the loader ignores this key. User files can't set protocol defaults. It must still be a valid definition, or the file fails to load."
        },
        "configurations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/configuration"
          },
          "default": []
        }
      }
    },
    "userDeviceIdentifier": {
      "description": "Identifies one physical device. `address` is platform-specific (for example, BLE addresses differ between OSes), so entries do not carry over between machines.",
      "type": "object",
      "properties": {
        "protocol": {
          "type": "string"
        },
        "identifier": {
          "anyOf": [
            {
              "type": "string",
              "description": "Protocol-reported identifier. `null` means the protocol defaults were used."
            },
            {
              "type": "null"
            }
          ]
        },
        "address": {
          "type": "string"
        }
      },
      "required": [
        "protocol",
        "address"
      ]
    },
    "u32RangeInclusive": {
      "description": "Inclusive range `[start, end]` with `start <= end`, within `[0, base end]`. An invalid range drops the whole device entry on load.",
      "type": "array",
      "prefixItems": [
        {
          "$ref": "#/$defs/u32"
        },
        {
          "$ref": "#/$defs/u32"
        }
      ],
      "minItems": 2,
      "maxItems": 2,
      "items": false
    },
    "userValueOutput": {
      "type": "object",
      "properties": {
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/u32RangeInclusive"
            },
            {
              "type": "null"
            }
          ],
          "description": "User step limit. If omitted, the full base range is used."
        },
        "disabled": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "userPositionOutput": {
      "type": "object",
      "properties": {
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/u32RangeInclusive"
            },
            {
              "type": "null"
            }
          ]
        },
        "disabled": {
          "type": "boolean",
          "default": false
        },
        "reverse": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "userHwPositionWithDurationOutput": {
      "type": "object",
      "properties": {
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/u32RangeInclusive"
            },
            {
              "type": "null"
            }
          ]
        },
        "duration": {
          "anyOf": [
            {
              "$ref": "#/$defs/u32RangeInclusive"
            },
            {
              "type": "null"
            }
          ]
        },
        "disabled": {
          "type": "boolean",
          "default": false
        },
        "reverse": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "userFeature": {
      "description": "Per-device overrides for one base feature. The index, description, input and settings always come from the base feature.",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "base_id": {
          "$ref": "#/$defs/uuid",
          "description": "`id` of the base feature."
        },
        "output": {
          "description": "Output overrides. Output types left out inherit the base output unchanged. Keys for output types the base feature doesn't have are ignored. A key that isn't an output type at all is a load error.",
          "type": "object",
          "properties": {
            "vibrate": {
              "$ref": "#/$defs/userValueOutput"
            },
            "rotate": {
              "$ref": "#/$defs/userValueOutput"
            },
            "oscillate": {
              "$ref": "#/$defs/userValueOutput"
            },
            "constrict": {
              "$ref": "#/$defs/userValueOutput"
            },
            "temperature": {
              "$ref": "#/$defs/userValueOutput"
            },
            "led": {
              "$ref": "#/$defs/userValueOutput"
            },
            "spray": {
              "$ref": "#/$defs/userValueOutput"
            },
            "position": {
              "$ref": "#/$defs/userPositionOutput"
            },
            "hw_position_with_duration": {
              "$ref": "#/$defs/userHwPositionWithDurationOutput"
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "base_id"
      ]
    },
    "userCustomization": {
      "type": "object",
      "properties": {
        "display_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "allow": {
          "type": "boolean",
          "default": false,
          "description": "Allow list. If any device is allowed, only allowed addresses can connect. Matching is by address only."
        },
        "deny": {
          "type": "boolean",
          "default": false,
          "description": "Deny list. Denied addresses never connect; this is checked before `allow`."
        },
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "description": "Stable device index. New devices get the lowest unused index."
        },
        "message_gap_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295,
              "description": "Overrides the base value. It REPLACES rather than inherits: if omitted, the device has no message gap. It is set from the base value when the device is first seen."
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "index"
      ]
    },
    "userDevice": {
      "type": "object",
      "properties": {
        "identifier": {
          "$ref": "#/$defs/userDeviceIdentifier"
        },
        "config": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "Not used: the loader ignores this key. Listed in older schemas. The name comes from the base definition."
            },
            "id": {
              "$ref": "#/$defs/uuid"
            },
            "base_id": {
              "$ref": "#/$defs/uuid",
              "description": "`id` of a base definition (`defaults` or `configurations`), or of a configuration in this file. If none matches, the entry is dropped."
            },
            "features": {
              "description": "Must contain one entry per base feature. On a count mismatch or an unknown `base_id`, the entry is silently dropped.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/userFeature"
              }
            },
            "user_config": {
              "$ref": "#/$defs/userCustomization"
            }
          },
          "required": [
            "id",
            "base_id",
            "features",
            "user_config"
          ]
        }
      },
      "required": [
        "identifier",
        "config"
      ]
    },
    "simulatedDevice": {
      "type": "object",
      "properties": {
        "identifier": {
          "type": "string",
          "description": "Archetype name. It must be listed in the base config's `simulated` protocol `communication[].simulated.names`, or the whole file is rejected. This can't be checked here because the base file can change; the examples are the archetypes in `device-config/protocols/simulated.yml`.",
          "examples": [
            "simulated-1vibe",
            "simulated-2vibe",
            "simulated-oscillator",
            "simulated-rotator",
            "simulated-stroker"
          ]
        },
        "display_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "address": {
          "type": "string",
          "description": "Unique address. If omitted, `simulated:<uuid v4>` is generated. A duplicate rejects the whole file."
        }
      },
      "required": [
        "identifier"
      ]
    }
  }
}
